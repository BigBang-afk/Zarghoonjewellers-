{
  "name": "@zarghoon/core",
  "version": "0.1.0",
  "private": true,
  "description": "Zarghoon AI core: database-backed business services and the Claude-powered Sales Agent.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./website": {
      "types": "./dist/channels/website/index.d.ts",
      "default": "./dist/channels/website/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "default": "./dist/dashboard/index.js"
    }
  },
  "files": [
    "dist",
    "supabase/migrations"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "products:import": "tsx scripts/import-products.ts",
    "sales": "tsx scripts/sales-playground.ts",
    "sales-agent": "tsx scripts/sales-agent-live.ts",
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "products:sync": "tsx scripts/products-sync.ts",
    "crm:report": "tsx scripts/crm-report.ts",
    "approvals": "tsx scripts/approvals.ts",
    "staff:account": "tsx scripts/staff-account.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0",
    "libphonenumber-js": "^1.13.15",
    "pg": "^8.23.1",
    "zod": "^4.6.7",
    "@electric-sql/pglite": "^0.5.10"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
