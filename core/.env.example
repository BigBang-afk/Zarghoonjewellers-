# Zarghoon AI core — copy to .env and fill in. Never commit .env.
#
# Server-side Postgres connection string (Supabase: Project Settings → Database
# → Connection string). This credential bypasses Row Level Security, so it must
# only ever be used from trusted server code — never shipped to a browser.
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# Optional. Set to "true" only in non-production environments to allow
# TEST- prefixed SKUs through the product importer.
ALLOW_TEST_SKUS="false"

# --- Sales Agent (see docs/sales-agent.md) ----------------------------------
# Server-side only. Never commit a real key.
ANTHROPIC_API_KEY=""
# SALES_AGENT_MODEL="claude-opus-5-5"
# SALES_AGENT_EFFORT="medium"            # low | medium | high | xhigh | max
# SALES_AGENT_MAX_TOKENS="8000"
# SALES_AGENT_TIMEOUT_MS="60000"
# SALES_AGENT_REFUSAL_FALLBACK="true"

# Owner-approved store facts (address, hours, phone...) as JSON.
# Unset = every store fact is "needs confirmation".
# BUSINESS_INFO_PATH="./config/business-info.json"

# Playground development database (never production). Requires ZARGHOON_ENV=development.
# ZARGHOON_ENV="development"
# SALES_PLAYGROUND_DATABASE_URL=""
