# Zarghoon AI core — copy to .env and fill in. Never commit .env.
#
# Server-side Postgres connection string (Supabase: Project Settings → Database
# → Connection string). This credential bypasses Row Level Security, so it must
# only ever be used from trusted server code — never shipped to a browser.
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# Optional. Set to "true" only in non-production environments to allow
# TEST- prefixed SKUs through the product importer.
ALLOW_TEST_SKUS="false"

# Reserved for the future Sales Agent phase (not used yet).
# ANTHROPIC_API_KEY=""
