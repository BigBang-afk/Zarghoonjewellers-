{
  "name": "zarghoon-jewellers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:core && next dev",
    "build": "npm run build:core && prisma migrate deploy && prisma db seed && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "build:core": "tsc -p core/tsconfig.build.json",
    "test:e2e": "playwright test",
    "test:e2e:cross-site": "E2E_CROSS_SITE=1 playwright test e2e/embed-cross-site.spec.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.0",
    "@zarghoon/core": "file:core",
    "bcryptjs": "^3.0.3",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
