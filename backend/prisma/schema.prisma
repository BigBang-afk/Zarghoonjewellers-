// =====================================================================
// RIVO — Phase 2 + Phase 3 Prisma schema
//
// Phase 3 additions (marketplace intelligence, retention, trust/safety,
// ops): incentive campaigns, referrals, favorite drivers, scheduled
// rides, business accounts, risk/fraud signals, notification
// preferences, promo redemption tracking, and driver online-session
// logging for accurate earnings/hour. All additive — no Phase 1/2 table
// was renamed or removed; see docs/13-phase-3-completion-report.md.
//
// Implements the Phase 1 entity model (docs/08-database-schema.sql) as a
// runnable application schema. Two portability notes vs. the canonical
// Postgres SQL doc, both driven by the SQLite dev database used to keep
// this project runnable with zero external infra:
//
//   1. Enums are modeled as `String` with the allowed values documented
//      in comments and enforced by the Zod schemas in src/types — SQLite
//      has no native enum type. Swapping `provider = "postgresql"` below
//      lets these become real Postgres enums later with a small migration.
//   2. Money/numeric fields use `Float` — SQLite has no Decimal type.
//      Swap to `Decimal` on Postgres for exact precision in production.
//
// Run `npx prisma migrate dev` in backend/ to create the local dev.db.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Geography
// ---------------------------------------------------------------------

model Country {
  id                    String   @id @default(uuid())
  name                  String
  isoCode               String   @unique
  defaultCurrencyCode   String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  cities                City[]

  @@map("countries")
}

/// status: planned | launching | live | paused
model City {
  id              String   @id @default(uuid())
  countryId       String
  name            String
  status          String   @default("planned")
  currencyCode    String
  timezone        String
  centerLat       Float?
  centerLng       Float?
  /// JSON-encoded weekly schedule, e.g. {"mon":["00:00","23:59"],...}; null = 24/7
  operatingHours  String?
  /// JSON-encoded array of allowed payment method codes for this city, e.g. ["cash","card","wallet"]; null = all methods
  paymentMethods  String?
  /// JSON-encoded jurisdiction-specific driver requirements, e.g. {"minAge":21,"minLicenseYears":1,"requiredDocs":["national_id","driving_license"]}; never hard-coded in application code (Phase 4 §16)
  driverRequirements String?
  /// JSON-encoded jurisdiction-specific passenger requirements, e.g. {"minAge":18,"requiredVerification":["phone"]}; enforced nowhere yet as hard business logic beyond phone verification, which already applies platform-wide — this is the config surface for a market that needs more (Phase 5 §1)
  customerRequirements String?
  /// Overrides the platform-wide matching.initialRadiusKm setting for this city's dispatch; null = use the platform default (Phase 5 §1)
  searchRadiusKm  Float?
  /// Default locale for a user whose primaryCityId is this city and who hasn't picked one themselves; null = platform default ("en")
  defaultLanguage String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  country         Country  @relation(fields: [countryId], references: [id])
  serviceZones    ServiceZone[]
  users           User[]
  driverProfiles  DriverProfile[]
  fareRules       FareRule[]
  rideRequests    RideRequest[]
  cityVehicleTypes CityVehicleType[]
  promotions      Promotion[]
  incentiveCampaigns IncentiveCampaign[]
  scheduledRides  ScheduledRide[]
  businessAccounts BusinessAccount[]
  contentItems    ContentItem[]
  driverAcquisitionCampaigns DriverAcquisitionCampaign[]

  @@unique([countryId, name])
  @@index([status])
  @@map("cities")
}

model ServiceZone {
  id              String   @id @default(uuid())
  cityId          String
  name            String
  boundaryGeoJson String   // JSON-encoded polygon
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  city            City     @relation(fields: [cityId], references: [id])
  rideRequests    RideRequest[]
  fareRules       FareRule[]

  @@unique([cityId, name])
  @@map("service_zones")
}

// ---------------------------------------------------------------------
// Vehicle types (data-driven)
// ---------------------------------------------------------------------

model VehicleType {
  id          String   @id @default(uuid())
  code        String   @unique // bike | rickshaw | economy | standard | premium
  name        String
  capacity    Int      @default(4)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles       Vehicle[]
  fareRules      FareRule[]
  rideRequests   RideRequest[]
  cityVehicleTypes CityVehicleType[]
  incentiveCampaigns IncentiveCampaign[]
  promotions      Promotion[]
  scheduledRides  ScheduledRide[]
  driverAcquisitionCampaigns DriverAcquisitionCampaign[]

  @@map("vehicle_types")
}

model CityVehicleType {
  cityId        String
  vehicleTypeId String
  isActive      Boolean @default(true)

  city          City        @relation(fields: [cityId], references: [id])
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])

  @@id([cityId, vehicleTypeId])
  @@map("city_vehicle_types")
}

// ---------------------------------------------------------------------
// Users & profiles
// ---------------------------------------------------------------------

/// role: passenger | driver | admin
/// status: active | suspended | banned | pending_verification
model User {
  id                String   @id @default(uuid())
  phone             String   @unique
  email             String?  @unique
  passwordHash      String?
  fullName          String
  photoUrl          String?
  role              String
  status            String   @default("pending_verification")
  primaryCityId     String?
  locale            String   @default("en")
  phoneVerifiedAt   DateTime?
  /// Attribution (Phase 4 §17): organic | referral | social | campaign | partner | other
  acquisitionSource String?
  /// Free-text campaign identifier when acquisitionSource is "campaign" (never required to be a real row elsewhere)
  acquisitionCampaign String?
  marketingOptIn    Boolean  @default(true)
  /// Set when the user requests account deletion (Phase 4 §26) — a human/job
  /// processes this; financial and ride records are never hard-deleted.
  deletionRequestedAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  primaryCity       City?    @relation(fields: [primaryCityId], references: [id])
  passengerProfile  PassengerProfile?
  driverProfile     DriverProfile?
  adminProfile      AdminUser?
  locations         Location[]
  notifications     Notification[]
  sentMessages      Message[]
  supportTickets    SupportTicket[] @relation("TicketAuthor")
  assignedTickets   SupportTicket[] @relation("TicketAssignee")
  supportMessages   SupportMessage[]
  safetyEvents      SafetyEvent[]
  wallet            Wallet?
  refreshTokens     RefreshToken[]
  otpCodes          OtpCode[]
  reviewedDriverDocs DriverDocument[] @relation("DocReviewer")
  reviewedVehicleDocs VehicleDocument[] @relation("VehicleDocReviewer")
  raisedDisputes    Dispute[] @relation("DisputeRaisedBy")
  resolvedDisputes  Dispute[] @relation("DisputeResolvedBy")
  blocksInitiated   UserBlock[] @relation("BlockInitiator")
  blocksReceived    UserBlock[] @relation("BlockTarget")
  ratingsGiven      Rating[] @relation("RatingRater")
  ratingsReceived   Rating[] @relation("RatingRatee")
  createdPromotions Promotion[]
  statusChanges     RideStatusHistory[]

  referralCode      ReferralCode?
  referralsMade     Referral[] @relation("Referrer")
  referralReceived  Referral?  @relation("Referred")
  riskEvents        RiskEvent[]
  riskScore         RiskScore?
  notificationPreferences NotificationPreference[]
  promoRedemptions  PromoRedemption[]
  businessEmployeeOf BusinessEmployee[]
  billingContactFor BusinessAccount[] @relation("BusinessBillingContact")
  assignedSafetyEvents SafetyEvent[] @relation("SafetyEventAssignee")
  contentItemsCreated ContentItem[]

  @@index([role, status])
  @@index([deletionRequestedAt])
  @@map("users")
}

model PassengerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  completedRides  Int      @default(0)
  cancelledRides  Int      @default(0)
  ratingAvg       Float    @default(5.0)
  ratingCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
  rideRequests    RideRequest[]
  rides           Ride[]
  favoriteDrivers FavoriteDriver[]
  scheduledRides  ScheduledRide[]

  @@map("passenger_profiles")
}

/// verificationStatus: pending | under_review | approved | rejected | expired
/// availabilityStatus: offline | online | on_trip
model DriverProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  cityId              String
  verificationStatus  String   @default("pending")
  availabilityStatus  String   @default("offline")
  licenseNumber       String?
  licenseExpiry       DateTime?
  completedRides      Int      @default(0)
  cancelledRides      Int      @default(0)
  ratingAvg           Float    @default(5.0)
  ratingCount         Int      @default(0)
  acceptanceRate      Float    @default(100.0)
  cancellationRate    Float    @default(0.0)
  lastLat             Float?
  lastLng             Float?
  lastLocationAt      DateTime?
  /// GPS accuracy radius in meters reported alongside the last ping, when
  /// the client provides one (Phase 4 §6) — used to flag poor-accuracy
  /// fixes for admin visibility, never to reject a location update.
  lastLocationAccuracyM Float?
  /// JSON {lat,lng,address,activeUntil} — a soft dispatch preference only
  /// (Phase 4 §10), never a routing guarantee; not yet factored into the
  /// matching score (see Phase 4 completion report, known limitations).
  destinationPreference String?
  /// Admin/driver-set personal daily earnings goal, purely informational.
  dailyEarningsTargetRs Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  user                User     @relation(fields: [userId], references: [id])
  city                City     @relation(fields: [cityId], references: [id])
  documents           DriverDocument[]
  vehicles            Vehicle[]
  rideOffers          RideOffer[]
  rides               Ride[]
  onlineSessions      DriverOnlineSession[]
  incentiveProgress   DriverIncentiveProgress[]
  incentiveRewards    IncentiveReward[]
  favoritedBy         FavoriteDriver[]
  payoutRequests      PayoutRequest[]
  acquisitionRewards  DriverAcquisitionReward[]

  @@index([cityId, availabilityStatus])
  @@index([verificationStatus])
  @@map("driver_profiles")
}

/// docType: national_id | driving_license | vehicle_registration | insurance | route_permit | profile_photo
/// status: pending | approved | rejected | expired
model DriverDocument {
  id                String   @id @default(uuid())
  driverId          String
  docType           String
  fileUrl           String
  status            String   @default("pending")
  reviewedById      String?
  reviewedAt        DateTime?
  rejectionReason   String?
  expiresAt         DateTime?
  expiryWarnedAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  driver            DriverProfile @relation(fields: [driverId], references: [id])
  reviewedBy        User?    @relation("DocReviewer", fields: [reviewedById], references: [id])

  @@index([driverId])
  @@index([status])
  @@map("driver_documents")
}

// ---------------------------------------------------------------------
// Vehicles
// ---------------------------------------------------------------------

/// status: pending | active | inactive | rejected
model Vehicle {
  id              String   @id @default(uuid())
  driverId        String
  vehicleTypeId   String
  make            String
  model           String
  year            Int?
  color           String?
  plateNumber     String   @unique
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  driver          DriverProfile @relation(fields: [driverId], references: [id])
  vehicleType     VehicleType   @relation(fields: [vehicleTypeId], references: [id])
  documents       VehicleDocument[]
  rideOffers      RideOffer[]
  rides           Ride[]

  @@index([driverId])
  @@map("vehicles")
}

model VehicleDocument {
  id              String   @id @default(uuid())
  vehicleId       String
  docType         String
  fileUrl         String
  status          String   @default("pending")
  reviewedById    String?
  reviewedAt      DateTime?
  expiresAt       DateTime?
  expiryWarnedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
  reviewedBy      User?    @relation("VehicleDocReviewer", fields: [reviewedById], references: [id])

  @@index([vehicleId])
  @@map("vehicle_documents")
}

// ---------------------------------------------------------------------
// Locations
// ---------------------------------------------------------------------

model Location {
  id          String   @id @default(uuid())
  userId      String?
  label       String?
  address     String
  lat         Float
  lng         Float
  isSaved     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  user        User?    @relation(fields: [userId], references: [id])
  pickupFor       RideRequest[] @relation("RequestPickup")
  destinationFor  RideRequest[] @relation("RequestDestination")
  ridePickupFor      Ride[] @relation("RidePickup")
  rideDestinationFor Ride[] @relation("RideDestination")
  scheduledPickupFor      ScheduledRide[] @relation("ScheduledPickup")
  scheduledDestinationFor ScheduledRide[] @relation("ScheduledDestination")

  @@index([userId])
  @@map("locations")
}

// ---------------------------------------------------------------------
// Fare engine configuration
// ---------------------------------------------------------------------

model FareRule {
  id                    String   @id @default(uuid())
  cityId                String
  zoneId                String?
  vehicleTypeId         String
  baseFare              Float
  perKmRate             Float
  perMinRate            Float
  minimumFare           Float
  maximumFare           Float?
  commissionRate        Float    // e.g. 0.15 = 15%
  commissionFlatFee     Float    @default(0) // added to the percentage cut, e.g. a flat booking fee
  surgeMinMultiplier    Float    @default(1.0)
  surgeMaxMultiplier    Float    @default(2.5)
  isActive              Boolean  @default(true)
  effectiveFrom         DateTime @default(now())
  effectiveTo           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  city        City         @relation(fields: [cityId], references: [id])
  zone        ServiceZone? @relation(fields: [zoneId], references: [id])
  vehicleType VehicleType  @relation(fields: [vehicleTypeId], references: [id])

  @@index([cityId, vehicleTypeId, zoneId])
  @@map("fare_rules")
}

/// Admin-configurable platform settings (matching radius, offer expiry, etc.)
/// — the enforcement point for "do not hard-code these values".
model PlatformSetting {
  key         String   @id
  value       String   // JSON-encoded value
  description String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

// ---------------------------------------------------------------------
// Ride requests, offers, counter-offers — the marketplace core
// ---------------------------------------------------------------------

/// bookingMode: quick_match | competitive_offer
/// status: searching | offers_open | matched | expired | cancelled
model RideRequest {
  id                        String   @id @default(uuid())
  passengerId                String
  cityId                     String
  zoneId                     String?
  vehicleTypeId               String
  pickupLocationId            String
  destinationLocationId       String
  bookingMode                 String
  suggestedFare                Float
  proposedFare                 Float
  distanceKm                  Float?
  estDurationMin                Int?
  paymentMethod                String   @default("cash")
  status                        String   @default("searching")
  searchRadiusKm                Float    @default(5)
  preferFavoriteDriver          Boolean  @default(false)
  promotionId                   String?
  discountAmount                Float    @default(0)
  businessAccountId             String?
  scheduledRideId               String?  @unique
  expiresAt                     DateTime
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  passenger    PassengerProfile @relation(fields: [passengerId], references: [id])
  city         City             @relation(fields: [cityId], references: [id])
  zone         ServiceZone?     @relation(fields: [zoneId], references: [id])
  vehicleType  VehicleType      @relation(fields: [vehicleTypeId], references: [id])
  pickup       Location         @relation("RequestPickup", fields: [pickupLocationId], references: [id])
  destination  Location         @relation("RequestDestination", fields: [destinationLocationId], references: [id])
  promotion    Promotion?       @relation(fields: [promotionId], references: [id])
  businessAccount BusinessAccount? @relation(fields: [businessAccountId], references: [id])
  scheduledRide   ScheduledRide?   @relation(fields: [scheduledRideId], references: [id])
  offers       RideOffer[]
  ride         Ride?

  @@index([passengerId])
  @@index([cityId, status])
  @@index([expiresAt])
  /// Phase 4 §29 — the negotiation sweep's exact filter shape (status IN [...] AND expiresAt < now), every 5s.
  @@index([status, expiresAt])
  @@map("ride_requests")
}

/// status: pending | accepted | declined | expired | withdrawn
model RideOffer {
  id              String   @id @default(uuid())
  rideRequestId   String
  driverId        String
  vehicleId       String
  offerPrice      Float
  etaMin          Int
  distanceKm      Float
  status          String   @default("pending")
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rideRequest     RideRequest   @relation(fields: [rideRequestId], references: [id])
  driver          DriverProfile @relation(fields: [driverId], references: [id])
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id])
  counterOffers   CounterOffer[]
  ride            Ride?

  @@unique([rideRequestId, driverId])
  @@index([rideRequestId, status])
  @@index([driverId, status])
  @@index([status, expiresAt])
  @@map("ride_offers")
}

/// status: pending | accepted | expired | withdrawn
model CounterOffer {
  id              String   @id @default(uuid())
  rideOfferId     String
  counterPrice    Float
  status          String   @default("pending")
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rideOffer       RideOffer @relation(fields: [rideOfferId], references: [id])

  @@index([rideOfferId, status])
  @@index([expiresAt])
  @@index([status, expiresAt])
  @@map("counter_offers")
}

// ---------------------------------------------------------------------
// Rides
// ---------------------------------------------------------------------

/// status: driver_selected | driver_arriving | driver_arrived | ride_started |
///         ride_completed | cancelled_by_passenger | cancelled_by_driver |
///         expired | disputed
model Ride {
  id                        String   @id @default(uuid())
  rideRequestId              String   @unique
  rideOfferId                 String?  @unique
  passengerId                  String
  driverId                     String
  vehicleId                    String
  pickupLocationId              String
  destinationLocationId         String
  agreedFare                    Float    // fare locked in at booking time
  finalFare                     Float?
  distanceKm                    Float?
  durationMin                   Int?
  paymentMethod                  String   @default("cash")
  status                         String   @default("driver_selected")
  businessAccountId              String?
  shareToken                     String?  @unique
  acceptedAt                     DateTime @default(now())
  arrivedAt                      DateTime?
  startedAt                      DateTime?
  completedAt                    DateTime?
  cancelledAt                    DateTime?
  cancellationReason              String?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  rideRequest   RideRequest      @relation(fields: [rideRequestId], references: [id])
  rideOffer     RideOffer?       @relation(fields: [rideOfferId], references: [id])
  passenger     PassengerProfile @relation(fields: [passengerId], references: [id])
  driver        DriverProfile    @relation(fields: [driverId], references: [id])
  vehicle       Vehicle          @relation(fields: [vehicleId], references: [id])
  pickup        Location         @relation("RidePickup", fields: [pickupLocationId], references: [id])
  destination   Location         @relation("RideDestination", fields: [destinationLocationId], references: [id])
  businessAccount BusinessAccount? @relation(fields: [businessAccountId], references: [id])

  locations     RideLocation[]
  statusHistory RideStatusHistory[]
  messages      Message[]
  payment       Payment?
  ratings       Rating[]
  safetyEvents  SafetyEvent[]
  disputes      Dispute[]
  supportTickets SupportTicket[]

  @@index([passengerId, status])
  @@index([driverId, status])
  @@index([status])
  @@map("rides")
}

model RideLocation {
  id          Int      @id @default(autoincrement())
  rideId      String
  lat         Float
  lng         Float
  heading     Float?
  speedKmh    Float?
  recordedAt  DateTime @default(now())

  ride        Ride     @relation(fields: [rideId], references: [id])

  @@index([rideId, recordedAt])
  @@map("ride_locations")
}

model RideStatusHistory {
  id          Int      @id @default(autoincrement())
  rideId      String
  status      String
  changedById String?
  note        String?
  changedAt   DateTime @default(now())

  ride        Ride     @relation(fields: [rideId], references: [id])
  changedBy   User?    @relation(fields: [changedById], references: [id])

  @@index([rideId, changedAt])
  @@map("ride_status_history")
}

// ---------------------------------------------------------------------
// Payments, wallets, transactions, commissions, promotions
// ---------------------------------------------------------------------

/// discountType: percentage | flat
/// campaignType (Phase 4 §15, cosmetic grouping only — all rule
/// enforcement still runs through the fields below): new_user | first_ride |
/// weekend | airport | city_launch | referral | driver_acquisition | business_promotion
model Promotion {
  id              String   @id @default(uuid())
  code            String   @unique
  description     String?
  campaignType    String?
  discountType    String
  discountValue   Float
  maxDiscount     Float?
  minFare         Float?
  cityId          String?
  vehicleTypeId   String?
  newUsersOnly    Boolean  @default(false)
  usageLimit      Int?
  usageCount      Int      @default(0)
  startsAt        DateTime @default(now())
  expiresAt       DateTime?
  isActive        Boolean  @default(true)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  city            City?        @relation(fields: [cityId], references: [id])
  vehicleType     VehicleType? @relation(fields: [vehicleTypeId], references: [id])
  createdBy       User?        @relation(fields: [createdById], references: [id])
  payments        Payment[]
  redemptions     PromoRedemption[]
  rideRequests    RideRequest[]

  @@index([isActive, expiresAt])
  @@map("promotions")
}

/// method: cash | card | wallet | local_provider
/// status: pending | authorized | captured | failed | refunded
model Payment {
  id                  String   @id @default(uuid())
  rideId              String   @unique
  promotionId         String?
  method              String
  status              String   @default("pending")
  amount              Float
  discountAmount      Float    @default(0)
  currencyCode        String
  providerReference   String?
  capturedAt          DateTime?
  refundedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  ride                Ride     @relation(fields: [rideId], references: [id])
  promotion           Promotion? @relation(fields: [promotionId], references: [id])
  commission          Commission?
  transactions        Transaction[]

  @@index([status])
  @@map("payments")
}

model Commission {
  id          String   @id @default(uuid())
  paymentId   String   @unique
  rate        Float
  amount      Float
  /// Denormalized from payment.currencyCode so this financial record is
  /// self-describing without a join (Phase 5 §2: "every financial record
  /// must contain currency").
  currencyCode String
  createdAt   DateTime @default(now())

  payment     Payment  @relation(fields: [paymentId], references: [id])

  @@map("commissions")
}

/// balance = available (withdrawable) balance. pendingBalance = earned but
/// not yet withdrawable (e.g. a just-completed ride payout still settling).
/// paidBalance = lifetime total actually paid out — a running total, never
/// decremented (Phase 4 §5: never claim money moved until the provider confirms it).
model Wallet {
  id              String   @id @default(uuid())
  userId          String   @unique
  balance         Float    @default(0)
  pendingBalance  Float    @default(0)
  paidBalance     Float    @default(0)
  currencyCode    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
  transactions    Transaction[]

  @@map("wallets")
}

/// type: ride_charge | ride_payout | commission | wallet_topup | withdrawal |
///       promo_credit | adjustment | refund | incentive_bonus | referral_reward |
///       acquisition_bonus
model Transaction {
  id              String   @id @default(uuid())
  walletId        String
  paymentId       String?
  type            String
  amount          Float    // signed: positive credit, negative debit
  balanceAfter    Float
  /// Denormalized from wallet.currencyCode so this financial record is
  /// self-describing without a join (Phase 5 §2: "every financial record
  /// must contain currency").
  currencyCode    String
  description     String?
  createdAt       DateTime @default(now())

  wallet          Wallet   @relation(fields: [walletId], references: [id])
  payment         Payment? @relation(fields: [paymentId], references: [id])

  @@index([walletId, createdAt])
  @@map("transactions")
}

// ---------------------------------------------------------------------
// Driver payouts (Phase 4 §5) — a payout is only ever COMPLETED once the
// payment provider actually confirms the transfer; never claimed earlier.
// ---------------------------------------------------------------------

/// status: requested | processing | completed | failed | cancelled
model PayoutRequest {
  id              String   @id @default(uuid())
  driverId        String
  amount          Float
  /// Denormalized from the driver's wallet.currencyCode at request time
  /// (Phase 5 §2: "every financial record must contain currency").
  currencyCode    String
  method          String   // matches PaymentMethod
  status          String   @default("requested")
  reference       String?  // provider payout/transfer reference, set once processing/completed
  notes           String?
  createdAt       DateTime @default(now())
  processedAt     DateTime?

  driver          DriverProfile @relation(fields: [driverId], references: [id])

  @@index([driverId, status])
  @@index([status, createdAt])
  @@map("payout_requests")
}

// ---------------------------------------------------------------------
// Payment webhooks (Phase 4 §4) — every inbound webhook is recorded once
// per (provider, eventId) so a redelivered event is a no-op, not a
// double-processed payment.
// ---------------------------------------------------------------------

model WebhookEvent {
  id              String   @id @default(uuid())
  provider        String
  eventId         String
  eventType       String
  payload         String   // JSON-encoded raw payload, for audit/replay
  status          String   @default("received") // received | processed | failed
  error           String?
  createdAt       DateTime @default(now())
  processedAt     DateTime?

  @@unique([provider, eventId])
  @@index([status, createdAt])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------
// Ratings, reviews, messaging, notifications
// ---------------------------------------------------------------------

model Rating {
  id          String   @id @default(uuid())
  rideId      String
  raterId     String
  rateeId     String
  score       Int
  tags        String?  // JSON-encoded string[]
  createdAt   DateTime @default(now())

  ride        Ride     @relation(fields: [rideId], references: [id])
  rater       User     @relation("RatingRater", fields: [raterId], references: [id])
  ratee       User     @relation("RatingRatee", fields: [rateeId], references: [id])
  review      Review?

  @@unique([rideId, raterId])
  @@index([rateeId])
  @@map("ratings")
}

model Review {
  id          String   @id @default(uuid())
  ratingId    String   @unique
  comment     String
  createdAt   DateTime @default(now())

  rating      Rating   @relation(fields: [ratingId], references: [id])

  @@map("reviews")
}

model Message {
  id          String   @id @default(uuid())
  rideId      String
  senderId    String
  body        String
  readAt      DateTime?
  createdAt   DateTime @default(now())

  ride        Ride     @relation(fields: [rideId], references: [id])
  sender      User     @relation(fields: [senderId], references: [id])

  @@index([rideId, createdAt])
  @@map("messages")
}

/// type: ride_update | offer_update | promo | system | safety
model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String
  title       String
  body        String?
  data        String?  // JSON-encoded payload
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, read, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------
// Support, disputes, safety
// ---------------------------------------------------------------------

/// category: payment | driver_issue | passenger_issue | lost_item | cancellation | pricing | technical | safety
/// status: open | in_progress | waiting | resolved | closed
/// priority: low | medium | high | urgent
model SupportTicket {
  id                  String   @id @default(uuid())
  userId              String
  rideId              String?
  category            String   @default("technical")
  subject             String
  description         String?
  status              String   @default("open")
  priority            String   @default("medium")
  assignedAdminId     String?
  /// Admin-only notes, never shown to the ticket author (Phase 4 §20).
  internalNotes       String?
  /// JSON-encoded array of evidence attachment URLs/descriptions.
  attachments         String?
  /// SLA target — set on assignment, purely informational (no auto-escalation).
  dueAt               DateTime?
  resolvedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation("TicketAuthor", fields: [userId], references: [id])
  ride                Ride?    @relation(fields: [rideId], references: [id])
  assignedAdmin       User?    @relation("TicketAssignee", fields: [assignedAdminId], references: [id])
  messages            SupportMessage[]

  @@index([status, priority])
  @@map("support_tickets")
}

/// The visible back-and-forth on a ticket (Phase 4 §20's "reply") —
/// distinct from SupportTicket.internalNotes, which neither party sees.
model SupportMessage {
  id           String   @id @default(uuid())
  ticketId     String
  authorUserId String
  isAdmin      Boolean  @default(false)
  body         String
  createdAt    DateTime @default(now())

  ticket       SupportTicket @relation(fields: [ticketId], references: [id])
  author       User          @relation(fields: [authorUserId], references: [id])

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

/// status: open | under_review | awaiting_info | resolved | rejected | closed
/// decision: refund_passenger | adjust_driver_payout | no_action
model Dispute {
  id              String   @id @default(uuid())
  rideId          String
  raisedById      String
  againstUserId   String?
  reason          String
  evidence        String?  // JSON-encoded string[] of attachment URLs/descriptions
  status          String   @default("open")
  decision        String?
  resolution      String?
  resolvedById    String?
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ride            Ride     @relation(fields: [rideId], references: [id])
  raisedBy        User     @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  resolvedBy      User?    @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])

  @@index([status])
  @@index([rideId])
  @@map("disputes")
}

/// A passenger or driver blocking a counterpart after riding together —
/// never matched to each other again (Phase 3 §15). Not a punitive action
/// against the blocked user elsewhere on the platform.
model UserBlock {
  id              String   @id @default(uuid())
  blockerUserId   String
  blockedUserId   String
  reason          String?
  createdAt       DateTime @default(now())

  blocker         User     @relation("BlockInitiator", fields: [blockerUserId], references: [id])
  blocked         User     @relation("BlockTarget", fields: [blockedUserId], references: [id])

  @@unique([blockerUserId, blockedUserId])
  @@index([blockedUserId])
  @@map("user_blocks")
}

/// type: sos | trip_shared | report_filed | suspicious_activity | ride_deviation
/// severity: low | medium | high | critical
model SafetyEvent {
  id          String   @id @default(uuid())
  rideId      String?
  userId      String
  type        String
  severity    String   @default("medium")
  details     String?  // JSON-encoded
  lat         Float?
  lng         Float?
  assignedAdminId String?
  /// Investigator notes (Phase 4 §21) — internal, never shown to the reporting user.
  notes       String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  ride        Ride?    @relation(fields: [rideId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  assignedAdmin User?  @relation("SafetyEventAssignee", fields: [assignedAdminId], references: [id])

  @@index([severity, resolvedAt])
  @@index([rideId])
  @@map("safety_events")
}

// ---------------------------------------------------------------------
// Admin, audit
// ---------------------------------------------------------------------

/// role: super_admin | ops_manager | support_agent | finance | safety_officer | read_only
model AdminUser {
  id          String   @id @default(uuid())
  userId      String   @unique
  role        String
  cityScope   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  user        User     @relation(fields: [userId], references: [id])
  auditLogs   AuditLog[]

  @@map("admin_users")
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  adminId       String
  action        String
  targetTable   String
  targetId      String?
  beforeState   String?  // JSON-encoded
  afterState    String?  // JSON-encoded
  ipAddress     String?
  createdAt     DateTime @default(now())

  admin         AdminUser @relation(fields: [adminId], references: [id])

  @@index([adminId, createdAt])
  @@index([targetTable, targetId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------
// Auth support (not in the Phase 1 ERD — needed to make auth real)
// ---------------------------------------------------------------------

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

/// Mock OTP store — see src/services/otp. Never used to bypass real
/// verification in a production build; MOCK_OTP=false disables the
/// dev-mode code echo in the API response.
model OtpCode {
  id          String   @id @default(uuid())
  userId      String?
  phone       String
  code        String
  purpose     String   // 'registration' | 'login' | 'reset_password'
  consumedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([phone, purpose])
  @@map("otp_codes")
}

// =====================================================================
// Phase 3 — marketplace intelligence, retention, trust, ops
// =====================================================================

// ---------------------------------------------------------------------
// Driver incentives (Phase 2 §8): admin-configurable campaigns, per-driver
// progress, and issued rewards — never a hard-coded bonus amount.
// ---------------------------------------------------------------------

/// status: draft | active | ended
model IncentiveCampaign {
  id              String   @id @default(uuid())
  name            String
  description     String?
  cityId          String?
  vehicleTypeId   String?
  targetRideCount Int
  rewardAmount    Float
  startDate       DateTime
  endDate         DateTime
  status          String   @default("active")
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  city            City?        @relation(fields: [cityId], references: [id])
  vehicleType     VehicleType? @relation(fields: [vehicleTypeId], references: [id])
  progress        DriverIncentiveProgress[]
  rewards         IncentiveReward[]

  @@index([status, startDate, endDate])
  @@map("incentive_campaigns")
}

/// status: in_progress | completed | rewarded
model DriverIncentiveProgress {
  id            String   @id @default(uuid())
  driverId      String
  campaignId    String
  currentCount  Int      @default(0)
  status        String   @default("in_progress")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  driver        DriverProfile     @relation(fields: [driverId], references: [id])
  campaign      IncentiveCampaign @relation(fields: [campaignId], references: [id])

  @@unique([driverId, campaignId])
  @@map("driver_incentive_progress")
}

model IncentiveReward {
  id            String   @id @default(uuid())
  driverId      String
  campaignId    String
  amount        Float
  transactionId String?
  awardedAt     DateTime @default(now())

  driver        DriverProfile     @relation(fields: [driverId], references: [id])
  campaign      IncentiveCampaign @relation(fields: [campaignId], references: [id])

  @@index([driverId])
  @@map("incentive_rewards")
}

// ---------------------------------------------------------------------
// Driver acquisition (Phase 5 §4) — distinct from IncentiveCampaign
// above: that rewards *existing* drivers for ride volume, this targets
// new driver signups. Attribution runs through the same acquisitionCampaign
// free-text field already captured at registration (Phase 4 §22) — a
// campaign's `code` is what a registration link is expected to pass as
// acquisitionCampaign, so funnel counts are a live query against
// User/DriverProfile, never a separately-maintained counter that can drift.
// ---------------------------------------------------------------------

/// status: draft | active | paused | completed
model DriverAcquisitionCampaign {
  id                String   @id @default(uuid())
  name              String
  code              String   @unique
  description       String?
  cityId            String?
  vehicleTypeId     String?
  targetDriverCount Int
  /// One-time signup bonus paid once an attributed driver is approved; null = no monetary incentive, tracking only.
  incentiveAmount   Float?
  startDate         DateTime
  endDate           DateTime
  status            String   @default("draft")
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  city              City?        @relation(fields: [cityId], references: [id])
  vehicleType       VehicleType? @relation(fields: [vehicleTypeId], references: [id])
  rewards           DriverAcquisitionReward[]

  @@index([status, startDate, endDate])
  @@map("driver_acquisition_campaigns")
}

model DriverAcquisitionReward {
  id            String   @id @default(uuid())
  driverId      String
  campaignId    String
  amount        Float
  currencyCode  String
  transactionId String?
  awardedAt     DateTime @default(now())

  driver        DriverProfile             @relation(fields: [driverId], references: [id])
  campaign      DriverAcquisitionCampaign @relation(fields: [campaignId], references: [id])

  @@unique([driverId, campaignId])
  @@map("driver_acquisition_rewards")
}

// ---------------------------------------------------------------------
// Referrals (Phase 2 §11)
// ---------------------------------------------------------------------

model ReferralCode {
  id        String   @id @default(uuid())
  userId    String   @unique
  code      String   @unique
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@map("referral_codes")
}

/// status: pending | qualified | rewarded | rejected
model Referral {
  id                    String   @id @default(uuid())
  referrerUserId        String
  referredUserId        String   @unique
  code                  String
  status                String   @default("pending")
  qualifyingAction      String?  // e.g. "first_ride_completed"
  rewardAmountReferrer  Float?
  rewardAmountReferred  Float?
  qualifiedAt           DateTime?
  rewardedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  referrer              User     @relation("Referrer", fields: [referrerUserId], references: [id])
  referred              User     @relation("Referred", fields: [referredUserId], references: [id])

  @@index([referrerUserId, status])
  @@map("referrals")
}

// ---------------------------------------------------------------------
// Favorite drivers (Phase 2 §12)
// ---------------------------------------------------------------------

model FavoriteDriver {
  id           String   @id @default(uuid())
  passengerId  String
  driverId     String
  createdAt    DateTime @default(now())

  passenger    PassengerProfile @relation(fields: [passengerId], references: [id])
  driver       DriverProfile    @relation(fields: [driverId], references: [id])

  @@unique([passengerId, driverId])
  @@map("favorite_drivers")
}

// ---------------------------------------------------------------------
// Scheduled rides (Phase 2 §13)
// ---------------------------------------------------------------------

/// status: scheduled | dispatched | completed | cancelled | expired
model ScheduledRide {
  id                      String   @id @default(uuid())
  passengerId             String
  cityId                  String
  zoneId                  String?
  vehicleTypeId           String
  pickupLocationId        String
  destinationLocationId   String
  bookingMode             String   @default("quick_match")
  proposedFare            Float?
  scheduledFor            DateTime
  status                  String   @default("scheduled")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  passenger    PassengerProfile @relation(fields: [passengerId], references: [id])
  city         City             @relation(fields: [cityId], references: [id])
  vehicleType  VehicleType      @relation(fields: [vehicleTypeId], references: [id])
  pickup       Location         @relation("ScheduledPickup", fields: [pickupLocationId], references: [id])
  destination  Location         @relation("ScheduledDestination", fields: [destinationLocationId], references: [id])
  rideRequest  RideRequest?

  @@index([status, scheduledFor])
  @@map("scheduled_rides")
}

// ---------------------------------------------------------------------
// Business / corporate accounts (Phase 2 §14) — architecture only, no
// deep billing engine yet, per the phase brief.
// ---------------------------------------------------------------------

model BusinessAccount {
  id                  String   @id @default(uuid())
  companyName         String
  billingContactUserId String
  cityId              String
  paymentMethod       String   @default("wallet")
  monthlySpendLimit   Float?
  ridePolicy          String?  // JSON-encoded policy (e.g. allowed vehicle types, hours)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  billingContact      User     @relation("BusinessBillingContact", fields: [billingContactUserId], references: [id])
  city                City     @relation(fields: [cityId], references: [id])
  employees           BusinessEmployee[]
  rideRequests        RideRequest[]
  rides               Ride[]

  @@map("business_accounts")
}

/// role: owner | member
model BusinessEmployee {
  id                String   @id @default(uuid())
  businessAccountId String
  userId            String
  role              String   @default("member")
  createdAt         DateTime @default(now())

  businessAccount   BusinessAccount @relation(fields: [businessAccountId], references: [id])
  user              User            @relation(fields: [userId], references: [id])

  @@unique([businessAccountId, userId])
  @@map("business_employees")
}

// ---------------------------------------------------------------------
// Fraud / risk monitoring (Phase 2 §22) — signals feed a score; a human
// always reviews before any punitive action (no auto-punish-on-signal).
// ---------------------------------------------------------------------

/// type: repeated_signup | promo_abuse | unusual_cancellation |
///       impossible_movement | shared_identifier | payment_failure | abnormal_offer_behavior
/// severity: low | medium | high | critical
model RiskEvent {
  id          String   @id @default(uuid())
  userId      String
  type        String
  severity    String   @default("low")
  details     String?  // JSON-encoded
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([severity, reviewedAt])
  @@map("risk_events")
}

model RiskScore {
  id          String   @id @default(uuid())
  userId      String   @unique
  score       Float    @default(0)
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])

  @@map("risk_scores")
}

// ---------------------------------------------------------------------
// Notification preferences (Phase 2 §20)
// ---------------------------------------------------------------------

model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String
  type      String   // matches NotificationType — ride_update|offer_update|promo|system|safety
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@map("notification_preferences")
}

// ---------------------------------------------------------------------
// Promo redemption tracking (Phase 2 §10) — one redemption per user per
// code by default, enforced by the unique constraint, not just app logic.
// ---------------------------------------------------------------------

model PromoRedemption {
  id            String   @id @default(uuid())
  promotionId   String
  userId        String
  rideId        String?
  discountAmount Float
  createdAt     DateTime @default(now())

  promotion     Promotion @relation(fields: [promotionId], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@unique([promotionId, userId])
  @@map("promo_redemptions")
}

// ---------------------------------------------------------------------
// Driver online sessions — logs each online/offline toggle so earnings
// "per hour" and incentive "opportunity" signals are computed from real
// elapsed time rather than approximated.
// ---------------------------------------------------------------------

model DriverOnlineSession {
  id         String    @id @default(uuid())
  driverId   String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  driver     DriverProfile @relation(fields: [driverId], references: [id])

  @@index([driverId, startedAt])
  @@map("driver_online_sessions")
}

// ---------------------------------------------------------------------
// Marketing CMS (Phase 4 §18) — ordinary marketing content changes
// without a code deploy. cityId null = shown in every city.
// ---------------------------------------------------------------------

/// type: banner | faq | announcement | help_article | app_message
model ContentItem {
  id          String   @id @default(uuid())
  type        String
  title       String
  body        String
  cityId      String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  city        City?    @relation(fields: [cityId], references: [id])
  createdBy   User?    @relation(fields: [createdById], references: [id])

  @@index([type, isActive, sortOrder])
  @@map("content_items")
}

// ---------------------------------------------------------------------
// Notification templates (Phase 4 §19) — admin-editable copy per
// notification key + locale, so wording changes don't need a deploy.
// notify() falls back to the in-code default string when no row exists.
// ---------------------------------------------------------------------

model NotificationTemplate {
  id        String   @id @default(uuid())
  key       String   // e.g. "ride.driver_arriving"
  locale    String   @default("en")
  title     String   // may contain {{placeholders}}
  body      String   // may contain {{placeholders}}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
  @@map("notification_templates")
}

// ---------------------------------------------------------------------
// Pre-launch waitlist (Phase 4 §38) — collects only what's needed.
// ---------------------------------------------------------------------

/// userType: passenger | driver
model WaitlistEntry {
  id                String   @id @default(uuid())
  fullName          String
  contact           String   // phone or email, whichever the visitor gave
  cityName          String
  userType          String
  marketingConsent  Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([cityName, userType])
  @@map("waitlist_entries")
}

// ---------------------------------------------------------------------
// Pilot Mode invitation codes (Phase 4 §37) — only checked when pilot
// mode + invite-only is turned on via PlatformSetting; harmless otherwise.
// ---------------------------------------------------------------------

model InvitationCode {
  id         String   @id @default(uuid())
  code       String   @unique
  maxUses    Int?
  usedCount  Int      @default(0)
  cityId     String?
  isActive   Boolean  @default(true)
  expiresAt  DateTime?
  createdAt  DateTime @default(now())

  @@map("invitation_codes")
}
