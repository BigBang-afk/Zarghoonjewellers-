# ---------------------------------------------------------------------
# RIVO backend — environment variables
# Copy to .env for local development. Never commit real secrets.
# ---------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Prisma datasource. SQLite for zero-config local dev; point at a real
# Postgres URL in staging/production (see docs/08-database-schema.sql /
# prisma/schema.prisma — schema is designed to be Postgres-portable).
DATABASE_URL="file:./dev.db"

# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS — the deployed frontend origin(s), comma-separated
CORS_ORIGIN=http://localhost:5173

# --- Mock/dev-mode toggles -------------------------------------------
# In development these return codes / succeed without calling a real
# provider. Set to "false" once real credentials are configured for the
# providers below, per docs/06-technical-architecture.md.
MOCK_OTP=true
MOCK_PAYMENTS=true
MOCK_NOTIFICATIONS=true

# --- Production credentials (NOT required in dev/mock mode) ----------
# SMS/OTP provider (e.g. Twilio)
# SMS_PROVIDER_ACCOUNT_SID=
# SMS_PROVIDER_AUTH_TOKEN=
# SMS_PROVIDER_FROM_NUMBER=

# Payments (e.g. Stripe)
# PAYMENTS_PROVIDER_SECRET_KEY=

# Push notifications (e.g. FCM)
# PUSH_PROVIDER_SERVER_KEY=

# Maps / routing (e.g. Google Maps, Mapbox) — unused while the
# Haversine dev MapProvider is active
# MAPS_PROVIDER_API_KEY=
