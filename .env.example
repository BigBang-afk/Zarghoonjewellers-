DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
AUTH_SECRET="replace-with-a-random-secret"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Admin account (prisma/seed.ts) — no default credentials exist -------------
# ADMIN_USERNAME=""
# ADMIN_PASSWORD=""            # at least 12 characters, letters and numbers
# ADMIN_ROTATE_PASSWORD="false" # "true" to rotate an existing admin's password
# Self-hosting outside Vercel: Auth.js needs AUTH_TRUST_HOST=true (or AUTH_URL).

# --- Zarghoon AI website chat (see core/docs/website-chat.md) --------------------
# Server-side only. Nothing here is ever sent to the browser.
# Mode: demo (in-memory DEMO data) | staging (persistent staging DB, test data) | live (real core DB) | off.
# Default: demo in development, off in production.
# ZARGHOON_CHAT_MODE="demo"
# ZARGHOON_CORE_DATABASE_URL=""   # staging/live: the Zarghoon AI core database (core/docs/database-and-sync.md)
# ANTHROPIC_API_KEY=""            # without it, demo mode uses a labelled offline stand-in; live mode is unavailable
# ZARGHOON_CHAT_DEBUG="false"     # development only: show lead score etc. in the chat (never in production)
# Rate limits / cost protection (per server instance):
# ZARGHOON_CHAT_SESSION_PER_MINUTE="8"
# ZARGHOON_CHAT_SESSION_PER_DAY="80"
# ZARGHOON_CHAT_IP_PER_MINUTE="20"
# ZARGHOON_CHAT_GLOBAL_PER_DAY="2000"

# --- Embedding the chat in an existing website (core/docs/website-embed.md) ----
# ZARGHOON_AI_SERVICE_ONLY="false"     # "true": serve only the chat (no other pages)
# ZARGHOON_EMBED_ALLOWED_ORIGINS=""    # e.g. "https://zarghoonjewllers.com https://www.zarghoonjewllers.com"
# ZARGHOON_EMBED_CROSS_SITE="false"    # "true" if the chat host is not a subdomain of the store

