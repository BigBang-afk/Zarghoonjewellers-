# Zarghoon AI management dashboard — copy to .env.local (gitignored). Server-side only.
# There is NO default mode and no fallback between modes.

# --- Demo: in-memory database with clearly fake records ---------------------------
ZARGHOON_DASHBOARD_MODE="demo"
# You choose this (12+ characters, letters and numbers). All demo-* users sign in with it.
ZARGHOON_DEMO_PASSWORD=""

# --- Connected: a real Zarghoon AI core database ------------------------------------
# ZARGHOON_DASHBOARD_MODE="connected"
# ZARGHOON_CORE_DATABASE_URL=""      # bypasses RLS: keep it in the server's secret store
# ZARGHOON_DASHBOARD_DB_ENV="staging" # the label the database must carry (development|staging|production)

# --- Optional -------------------------------------------------------------------------------
# ZARGHOON_BUSINESS_TIMEZONE="Asia/Karachi"
# ZARGHOON_DASHBOARD_LOGINS_PER_MINUTE="10"   # per client address
# ZARGHOON_DASHBOARD_LOGINS_PER_HOUR="20"     # per username
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""       # required when running more than one instance
