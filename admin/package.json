{
  "name": "zarghoon-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Zarghoon AI management dashboard (staff only). Separate from the public website.",
  "scripts": {
    "build:core": "npm --prefix ../core run build",
    "dev": "npm run build:core && next dev -p 3100",
    "build": "npm run build:core && next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@zarghoon/core": "file:../core",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
